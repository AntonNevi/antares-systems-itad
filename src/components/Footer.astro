---
import { SITE, FOOTER_NOTE, NAV } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/logo_antares_light.svg" alt="Antares Systems" width="166" height="46" />
        <p>Business finance solutions for UK companies and property investors.</p>
      </div>
      <div>
        <p class="f-title">Services</p>
        <ul>
          {NAV.slice(0, 4).map((l) => <li><a href={l.href}>{l.text}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="f-title">Company</p>
        <ul>
          <li><a href="/history/">History</a></li>
          <li><a href="/contacts/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms-of-service/">Terms of use</a></li>
        </ul>
      </div>
      <div>
        <p class="f-title">Contact</p>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
          <li>London, United Kingdom</li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>{FOOTER_NOTE}</p>
      <p>
        &copy; {year} {SITE.legalName}. Registered in England and Wales, company no. {SITE.companyNo}. Registered office: {SITE.address.join(', ')}.
        VAT no. {SITE.vat.replace('GB', 'GB ')}. ICO registration {SITE.ico}.
      </p>
    </div>
  </div>
</footer>
