---
import { SITE, STATUS_SHORT } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/logo_antares_light.svg" alt="Antares Systems" width="166" height="46" />
        <p>Business finance solutions for UK limited companies and property investors, and IT asset buyback.</p>
      </div>
      <div>
        <p class="f-title">Services</p>
        <ul>
          <li><a href="/services/#property-finance">Property finance</a></li>
          <li><a href="/services/#buy-to-let-spv">Buy-to-let for SPVs</a></li>
          <li><a href="/services/#capex-finance">CAPEX finance</a></li>
          <li><a href="/services/#working-capital">OPEX and working capital</a></li>
          <li><a href="/services/#it-asset-buyback">IT asset buyback</a></li>
        </ul>
      </div>
      <div>
        <p class="f-title">Company</p>
        <ul>
          <li><a href="/history/">History</a></li>
          <li><a href="/contacts/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms-of-service/">Terms of use</a></li>
        </ul>
      </div>
      <div>
        <p class="f-title">Contact</p>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></li>
          <li>London, United Kingdom</li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>{STATUS_SHORT}</p>
      <p>
        &copy; {year} {SITE.legalName}. Registered in England and Wales, company no. {SITE.companyNo}. Registered office: {SITE.address.join(', ')}.
        VAT no. {SITE.vat.replace('GB', 'GB ')}. ICO registration {SITE.ico}.
      </p>
    </div>
  </div>
</footer>
