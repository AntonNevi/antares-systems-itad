---
import { NAV } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="/" aria-label="Antares Systems, home">
        <img src="/logo_antares.svg" alt="Antares Systems" width="166" height="46" />
      </a>
      <nav class="nav" aria-label="Main">
        {NAV.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.text}</a>)}
      </nav>
      <a class="btn btn-primary header-cta" href="/contacts/">Discuss your funding</a>
      <button class="menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-open="false">
    <div class="wrap">
      {NAV.map((l) => <a href={l.href}>{l.text}</a>)}
      <a class="btn btn-primary" href="/contacts/">Discuss your funding</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.getAttribute('data-open') === 'true';
      menu.setAttribute('data-open', String(!open));
      btn.setAttribute('aria-expanded', String(!open));
      btn.textContent = open ? 'Menu' : 'Close';
    });
  }
</script>
