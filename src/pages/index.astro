---
import BaseLayout from '../layouts/BaseLayout.astro';
import Visual from '../components/Visual.astro';
import { pages, INTRO_STEPS } from '../data/services';
import { SITE } from '../data/site';

const steps = INTRO_STEPS;
---

<BaseLayout
  title="Business Finance Solutions for UK Companies | Antares Systems"
  description="Property, buy-to-let, asset and working capital finance and debt review for UK companies, via our partner network of 200+ lenders, creditors and banks."
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <h1>Business Finance Solutions</h1>
          <p class="lead">
            Our mission is to put the capital markets to work for your business: funding that is efficient, well structured and built around your plans, so you can operate effectively and grow profitably.
          </p>
          <p class="lead">
            Property finance, buy-to-let, asset finance, working capital and debt refinancing for UK companies and property investors, sourced through our partner network of 200+ lenders, creditors and banks. We prepare your case, take it to the lenders best placed to fund it, and support you through to completion.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/contacts/">Discuss your funding</a>
            <a class="btn btn-secondary" href="/property-finance/">Explore property finance</a>
          </div>
        </div>
        <div class="art-box"><Visual name="hero" eager /></div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="strip">
      <div><strong>ICO registered</strong>Registration {SITE.ico}</div>
      <div><strong>Insured</strong>Public liability and professional indemnity</div>
      <div><strong>UK company</strong>Registered in England and Wales, no. {SITE.companyNo}</div>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Funding for property, assets and growth</h2>
      </div>
      <div class="tiles">
        {pages.map((s) => (
          <article class="tile">
            <span class="label">{s.label}</span>
            <h3><a href={s.path}>{s.tileTitle}</a></h3>
            <p>{s.tile}</p>
            <span class="more" aria-hidden="true">Read more &rarr;</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>From first conversation to funding</h2>
      </div>
      <div class="steps">
        {steps.map((s, i) => (
          <div class="step">
            <span class="n">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Why work with us</span>
        <h2>Prepared on the borrower's side first</h2>
      </div>
      <div class="why">
        <div>
          <h3>Borrower-side experience</h3>
          <p>Our director spent more than ten years raising and managing debt inside a large group of companies. We know what lenders look for because we have sat on your side of the table.</p>
        </div>
        <div>
          <h3>Well-prepared cases</h3>
          <p>A clear summary of your business and your request saves time and avoids surprises later.</p>
        </div>
        <div>
          <h3>Transparency</h3>
          <p>We tell you how we are paid before you proceed.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Planning a purchase, refinance or expansion?</h2>
          <p>Tell us what you need and we will come back to you with next steps.</p>
        </div>
        <a class="btn btn-inverse" href="/contacts/">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
