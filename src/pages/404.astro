---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Antares Systems" description="This page could not be found." noindex>
  <section class="section">
    <div class="wrap">
      <div class="measure stack-24">
        <span class="eyebrow">404</span>
        <h1>Page not found</h1>
        <p class="lead">The page you are looking for has moved or does not exist.</p>
        <div class="actions"><a class="btn btn-primary" href="/">Go to the home page</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
