---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Visual from '../components/Visual.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Contact Antares Systems | Business Finance & IT Buyback"
  description="Contact Antares Systems in London about finance for your company or SPV, or about selling surplus business IT equipment. We respond promptly."
  type="ContactPage"
  crumb="Contact"
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Contact us</h1>
      <p class="lead">Tell us briefly what you need and we will respond promptly.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div>
          <h2>Direct details</h2>
          <dl class="details" style="margin-top: 24px">
            <div><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
            <div><dt>Telephone</dt><dd><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></dd></div>
            <div><dt>LinkedIn</dt><dd><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Anton Nevinnykh</a></dd></div>
            <div><dt>Based in</dt><dd>London, United Kingdom</dd></div>
          </dl>
          <p class="small" style="margin-top: 32px; color: var(--color-muted)">
            We work with UK companies, LLPs and special purpose vehicles. Through our partner network of 200+ lenders, creditors and banks, we help you find the right finance.
          </p>
          <div class="art-box" style="margin-top: 32px; max-width: 380px"><Visual name="working-capital" /></div>
        </div>
        <div>
          <h2>Send an enquiry</h2>
          <div style="margin-top: 24px"><ContactForm /></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
