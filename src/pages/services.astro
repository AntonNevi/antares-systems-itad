---
import BaseLayout from '../layouts/BaseLayout.astro';
import Visual from '../components/Visual.astro';
import { serviceNodes } from '../data/seo';
import { services } from '../data/services';
import { RISK_NOTICE } from '../data/site';
---

<BaseLayout
  title="Business Finance and IT Buyback Services | Antares Systems"
  description="Property finance, SPV buy-to-let, CAPEX and working capital for UK businesses, introduced through a regulated partner. Plus IT buyback with data erasure."
  crumb="Services"
  schema={serviceNodes()}
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Services</span>
      <h1>Business finance and IT asset buyback</h1>
      <p class="lead">
        Business finance for UK limited companies, LLPs and property investors, and IT asset buyback for businesses. For finance, we introduce you to our regulated partner. We do not give advice or arrange finance ourselves.
      </p>
    </div>
  </section>

  <div class="wrap">
    {services.map((s, i) => (
      <section class="service" id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class:list={['service-grid', { flip: i % 2 === 1 }]}>
          <div>
            <span class="eyebrow">{s.label}</span>
            <h2 id={`${s.id}-title`}>{s.title}</h2>
            <p class="summary">{s.summary}</p>

            {s.uses.length > 0 && (
              <>
                <span class="label">{s.usesTitle}</span>
                <ul class="uses">{s.uses.map((u) => <li>{u}</li>)}</ul>
              </>
            )}
            {s.steps && (
              <>
                <span class="label">{s.usesTitle}</span>
                <ol class="numbered">{s.steps.map((u) => <li>{u}</li>)}</ol>
              </>
            )}

            <dl class="facts">
              {s.rows.map((r) => (
                <div>
                  <dt>{r.k}</dt>
                  <dd>{r.v}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="art-box"><Visual name={s.art} eager={i === 0} /></div>
        </div>
      </section>
    ))}
  </div>

  <section class="section section--alt">
    <div class="wrap">
      <div class="measure">
        <div class="notice">
          <strong>Important information</strong>
          {RISK_NOTICE}
        </div>
        <div class="actions" style="margin-top: 32px">
          <a class="btn btn-primary" href="/contacts/">Discuss your funding</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
