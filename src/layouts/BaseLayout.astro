---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { organization, director, website, WEBSITE_ID, ORG_ID, HOME, OG_IMAGE } from '../data/seo';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';

type PageType = 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
interface Props {
  title: string;
  description: string;
  type?: PageType;
  crumb?: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, description, type = 'WebPage', crumb, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = canonical === HOME;

const page = {
  '@type': type,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en-GB',
  isPartOf: { '@id': WEBSITE_ID },
  ...(isHome ? { about: { '@id': ORG_ID }, primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE.url}/img/hero.webp` } } : {}),
  ...(crumb ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
};
const breadcrumb = crumb
  ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: HOME },
        { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
      ],
    }]
  : [];
const graph = { '@context': 'https://schema.org', '@graph': [organization, director, website, page, ...breadcrumb, ...schema] };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#234B80" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE.url} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE.url} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
